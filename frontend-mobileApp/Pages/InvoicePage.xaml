<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SalesMobileApp.Pages.InvoicePage" Title="Ghi nhận doanh số"><ScrollView><VerticalStackLayout Padding="22,24" Spacing="14"><Label Text="Tại điểm bán" Style="{StaticResource EyebrowLabel}"/><Label Text="Ghi nhận hóa đơn" Style="{StaticResource PageTitle}"/><Label Text="Chỉ chọn zone thuộc ca hôm nay." Style="{StaticResource MutedLabel}"/><Border Style="{StaticResource PanelBorder}"><VerticalStackLayout Padding="18" Spacing="12"><Label Text="Zone" Style="{StaticResource FieldLabel}"/><Picker ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" ItemDisplayBinding="{Binding name}" Title="Chọn zone"/><Label Text="Số đơn" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Orders}" Keyboard="Numeric"/><Label Text="Số khách hàng" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Customers}" Keyboard="Numeric"/><Label Text="Giá trị hóa đơn" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Amount}" Keyboard="Numeric" Placeholder="0"/><Label Text="Ghi chú" Style="{StaticResource FieldLabel}"/><Editor Text="{Binding Notes}" Placeholder="Ghi chú tại điểm bán" AutoSize="TextChanges"/><Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding Error, Converter={StaticResource StringNotEmptyConverter}}"/><Label Text="{Binding Message}" Style="{StaticResource SuccessLabel}" IsVisible="{Binding Message, Converter={StaticResource StringNotEmptyConverter}}"/><Button Text="Lưu ghi nhận" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}"/></VerticalStackLayout></Border></VerticalStackLayout></ScrollView></ContentPage>
