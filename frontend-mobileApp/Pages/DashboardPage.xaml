<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SalesMobileApp.Pages.DashboardPage" Shell.NavBarIsVisible="False">
  <Grid RowDefinitions="Auto,*" Padding="22,24,22,14" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Hôm nay" Style="{StaticResource EyebrowLabel}"/><Label Text="Ca làm việc" Style="{StaticResource PageTitle}"/></VerticalStackLayout><Button Grid.Column="1" Text="Hồ sơ" Command="{Binding OpenProfileCommand}" Style="{StaticResource QuietButton}"/></Grid>
    <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}"><ScrollView><VerticalStackLayout Spacing="16">
      <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding Error, Converter={StaticResource StringNotEmptyConverter}}"/>
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}"/>
      <Border Style="{StaticResource AccentPanel}"><VerticalStackLayout Padding="18" Spacing="5"><Label Text="{Binding Shift.territory.name}" Style="{StaticResource CardTitle}"/><Label Text="{Binding Shift.date}" Style="{StaticResource MutedLabel}"/><Label Text="{Binding Shift.summary.total_zones, StringFormat='{}{0} zone được giao'}" Style="{StaticResource StatNumber}"/></VerticalStackLayout></Border>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><Border Style="{StaticResource MetricBorder}"><VerticalStackLayout Padding="12"><Label Text="Khách" Style="{StaticResource CaptionLabel}"/><Label Text="{Binding Shift.summary.total_customers}" Style="{StaticResource MetricValue}"/></VerticalStackLayout></Border><Border Grid.Column="1" Style="{StaticResource MetricBorder}"><VerticalStackLayout Padding="12"><Label Text="Đơn" Style="{StaticResource CaptionLabel}"/><Label Text="{Binding Shift.summary.total_orders}" Style="{StaticResource MetricValue}"/></VerticalStackLayout></Border><Border Grid.Column="2" Style="{StaticResource MetricBorder}"><VerticalStackLayout Padding="12"><Label Text="Doanh thu" Style="{StaticResource CaptionLabel}"/><Label Text="{Binding Shift.summary.total_revenue, StringFormat='{}{0:N0}'}" Style="{StaticResource MetricValue}"/></VerticalStackLayout></Border></Grid>
      <Label Text="Zone trong ca" Style="{StaticResource SectionTitle}"/><Label Text="Chưa có ca được chốt cho hôm nay." Style="{StaticResource MutedLabel}" IsVisible="{Binding HasShift, Converter={StaticResource InverseBoolConverter}}"/>
      <CollectionView ItemsSource="{Binding Shift.zones}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelBorder}" Margin="0,0,0,9"><Grid Padding="14" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding name}" Style="{StaticResource CardTitle}"/><Label Text="{Binding zone_code}" Style="{StaticResource CaptionLabel}"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding num_orders, StringFormat='{}{0} đơn'}" Style="{StaticResource AccentText}" VerticalOptions="Center"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
      <Button Text="Ghi nhận doanh số" Command="{Binding OpenInvoiceCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasZones}"/><Button Text="Xem lịch sử" Command="{Binding OpenHistoryCommand}" Style="{StaticResource QuietButton}"/>
    </VerticalStackLayout></ScrollView></RefreshView>
  </Grid>
</ContentPage>
