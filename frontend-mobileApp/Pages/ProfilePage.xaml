<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SalesMobileApp.Pages.ProfilePage" Title="Hồ sơ"><ScrollView><VerticalStackLayout Padding="22,24" Spacing="16"><Label Text="Tài khoản Sales" Style="{StaticResource EyebrowLabel}"/><Label Text="Hồ sơ của tôi" Style="{StaticResource PageTitle}"/><Border Style="{StaticResource PanelBorder}"><VerticalStackLayout Padding="18" Spacing="12"><Label Text="Tên hiển thị" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding FullName}" Placeholder="Tên của bạn"/><Label Text="Email" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Email}" Keyboard="Email"/><Label Text="Số điện thoại" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Phone}" Keyboard="Telephone"/><Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding Error, Converter={StaticResource StringNotEmptyConverter}}"/><Label Text="{Binding Message}" Style="{StaticResource SuccessLabel}" IsVisible="{Binding Message, Converter={StaticResource StringNotEmptyConverter}}"/><Button Text="Lưu thay đổi" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></VerticalStackLayout></Border></VerticalStackLayout></ScrollView></ContentPage>
