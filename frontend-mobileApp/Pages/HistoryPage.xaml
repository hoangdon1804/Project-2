<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SalesMobileApp.Pages.HistoryPage" Title="Lịch sử">
<Grid Padding="22,24,22,14" RowDefinitions="Auto,*" RowSpacing="14"><VerticalStackLayout><Label Text="Dữ liệu bán hàng" Style="{StaticResource EyebrowLabel}"/><Label Text="Lịch sử hoạt động" Style="{StaticResource PageTitle}"/></VerticalStackLayout><RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}"><CollectionView ItemsSource="{Binding Items}"><CollectionView.EmptyView><VerticalStackLayout Padding="0,60" Spacing="8"><Label Text="Chưa có hoạt động" Style="{StaticResource CardTitle}" HorizontalOptions="Center"/><Label Text="Các lần ghi nhận doanh số sẽ xuất hiện tại đây." Style="{StaticResource MutedLabel}" HorizontalOptions="Center"/></VerticalStackLayout></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10"><VerticalStackLayout Padding="15" Spacing="4"><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding zone_name}" Style="{StaticResource CardTitle}"/><Label Grid.Column="1" Text="{Binding total_revenue, StringFormat='{}{0:N0} đ'}" Style="{StaticResource AccentText}"/></Grid><Label Text="{Binding territory_name}" Style="{StaticResource CaptionLabel}"/><Label Text="{Binding num_orders, StringFormat='{}{0} đơn · {1} khách'}" Style="{StaticResource MutedLabel}"/><Label Text="{Binding updated_at}" Style="{StaticResource CaptionLabel}"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></RefreshView></Grid></ContentPage>
